{
  "name": "forecall-mcp",
  "version": "0.1.0",
  "description": "Connect an MCP client that starts servers over stdio, such as Claude Desktop, to the Forecall Failure KB.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "stdio",
    "ai-agents"
  ],
  "homepage": "https://forecall.dev/en/docs/kb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forecall/forecall-mcp.git"
  },
  "bugs": "https://github.com/forecall/forecall-mcp/issues",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "forecall-mcp": "dist/forecall-mcp.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "vitest run",
    "build": "node build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  }
}
